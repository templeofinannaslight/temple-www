# ==============================================
# MIKKI'S MESS - Environment Configuration
# ==============================================

# ----------------------------------------------
# SERVER-SIDE ONLY (NOT exposed to browser)
# ----------------------------------------------

# Directus CMS URL (internal/private network)
DIRECTUS_URL=http://content.rso:8055

# Directus API Token (keep secret!)
DIRECTUS_TOKEN=your_directus_token_here

# Directus folder UUID for image uploads (WordPress migration)
DIRECTUS_FOLDER_ID=your_folder_uuid_here

# Express API server port
PORT=3001

# CORS origin (allowed frontend URL)
# Dev: http://localhost:5173
# Prod: https://yourdomain.com
CORS_ORIGIN=http://localhost:5173

# ----------------------------------------------
# CLIENT-SIDE (exposed to browser via Vite)
# ----------------------------------------------

# API URL for frontend to call
# Dev:  /api (uses Vite proxy to localhost:3001)
# Prod: https://content.recoverysky.org/api (full URL)
VITE_API_URL=/api

# ==============================================
# DEPLOYMENT NOTES
# ==============================================
#
# DEVELOPMENT:
#   - VITE_API_URL=/api (Vite dev proxy handles routing)
#   - Run: pnpm dev (starts both Express + Vite)
#
# PRODUCTION:
#   - VITE_API_URL=https://content.recoverysky.org/api
#   - Frontend: Build with 'pnpm build', deploy static files
#   - Backend: Run Express server with 'pnpm start'
#   - Ensure Express server can reach DIRECTUS_URL
#
